{
  "name": "temprouter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential-inference rail for agents on Tempo — verify a real Intel TDX enclave, then pay per response-chunk in pathUSD. Server + SDK + CLI + MCP.",
  "workspaces": ["sdk", "cli", "mcp"],
  "scripts": {
    "build": "npm run build -w @temprouter/sdk",
    "prepare": "npm run build -w @temprouter/sdk",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "agent": "tsx src/agent.ts",
    "usecases": "tsx examples/usecases.ts",
    "cli": "tsx cli/temprouter.ts",
    "mcp": "tsx mcp/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p sdk/tsconfig.json && tsc --noEmit -p cli/tsconfig.json && tsc --noEmit -p mcp/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phala/dcap-qvl": "^0.5.2",
    "@solrouter/sdk": "^1.1.0",
    "hono": "^4.12.25",
    "mppx": "^0.7.0",
    "tsx": "^4.22.4",
    "viem": "^2.52.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
