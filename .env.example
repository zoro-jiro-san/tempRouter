# ── tempRouter: MPP-paid, attestation-gated private AI inference on Tempo ─────
# Copy to .env (auto-loaded). All values have safe defaults; nothing here is required
# to boot in stub mode (no live TDX → agents correctly refuse to pay).

# ── Server (the blind relay) ──────────────────────────────────────────────────

# Real Phala Intel TDX enclave base (…/tee). Set → tdx-live mode; unset → stub mode.
TEE_ENDPOINT=https://solrouter-obb4.onrender.com/tee

# HMAC secret that binds MPP payment challenges to their contents (NOT a chain key).
MPP_SECRET_KEY=change-me-to-a-long-random-string

# Wallet that RECEIVES pathUSD payments (your earnings address on Tempo).
TEMPO_RECIPIENT=0xa726a1CD723409074DF9108A2187cfA19899aCF8

# Optional PAYEE private key (address MUST equal TEMPO_RECIPIENT). Set → the server
# cooperatively CLOSES the channel on-chain as the payee (open+close ≈ 2 txs, fee paid
# from its own pathUSD). Unset → close is best-effort; the deposit reclaims on timeout.
TEMPO_RECIPIENT_PRIVATE_KEY=

# pathUSD per response-chunk (the metered unit). 6-decimal TIP-20 units.
PRICE_PER_UNIT=0.0002

# How many SSE chunks the relay slices the enclave reply into (one voucher tick each).
# 1 = one charge per inference (prod default); >1 meters a response in N ticks.
CHUNK_COUNT=1

# Optional strict-pin: reject the quote unless mrtd == this. Unset → soft-pin (display).
EXPECTED_MEASUREMENT=

PORT=8402
# debug | info | warn | error (default info). Optional request/timeout overrides:
# LOG_LEVEL=info
# MAX_BODY_BYTES=1000000
# TEE_PROCESS_TIMEOUT_MS=90000

# ── Client / agent side (src/agent.ts, CLI, MCP) ──────────────────────────────
# Funded Tempo testnet private key used by the paying agent. Faucet:
# https://explore.testnet.tempo.xyz
AGENT_PRIVATE_KEY=
SERVER_URL=http://localhost:8402
# pathUSD deposit headroom the agent locks per session (human units).
MAX_DEPOSIT=1
